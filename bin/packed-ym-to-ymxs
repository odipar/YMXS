#!/bin/sh
# A distributed .ym, which is usually an archive holding a register dump,
# into the text form. It unpacks what it is handed and runs ym-to-ymxs on
# what comes out, so the reader itself stays a reader of dumps. doc/ym.md.
#
#   bin/packed-ym-to-ymxs in.ym [more.ym ...] out.json [-rROW | -r]
#
# A file that is already a dump is passed through. Unpacking is 7z, 7zz or
# lha, whichever is on the path.
set -e

say() {
    echo "packed-ym-to-ymxs: $1" >&2
}

usage() {
    echo "packed-ym-to-ymxs in.ym [more.ym ...] out.json [-rROW | -r]" >&2
}

case $1 in
    -h|--help|"")
        usage
        exit 2
        ;;
esac

# The flags go to the reader; the names are this script's.
flags=
for arg do
    case $arg in
        -*) flags="$flags $arg" ;;
    esac
done
total=$#
at=0
while [ "$at" -lt "$total" ]; do
    arg=$1
    shift
    case $arg in
        -*) : ;;
        *) set -- "$@" "$arg" ;;
    esac
    at=$((at + 1))
done
if [ $# -lt 2 ]; then
    usage
    exit 2
fi

unpacker=
for one in 7zz 7z lha; do
    if command -v "$one" >/dev/null 2>&1; then
        unpacker=$one
        break
    fi
done

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM

# The dump inside one file: the file itself where it is one already, and
# what comes out of the archive where it is not.
dump() {
    packed=$1
    if [ ! -f "$packed" ]; then
        say "$packed: no such file"
        exit 2
    fi
    case $(head -c 4 "$packed" 2>/dev/null) in
        YM5!|YM6!)
            printf '%s\n' "$packed"
            return
            ;;
    esac
    if [ -z "$unpacker" ]; then
        say "$packed is an archive and no unpacker is on the path: 7z, 7zz or lha"
        exit 2
    fi
    # A directory of its own each time. This runs inside a command
    # substitution, so nothing it counts would reach the next call.
    into=$(mktemp -d "$work/XXXXXX")
    whole=$(cd "$(dirname "$packed")" && pwd)/$(basename "$packed")
    case $unpacker in
        7z|7zz) "$unpacker" x -y -o"$into" "$whole" >/dev/null 2>&1 || true ;;
        lha) (cd "$into" && lha xq "$whole" >/dev/null 2>&1) || true ;;
    esac
    for one in "$into"/* "$into"/*/*; do
        [ -f "$one" ] || continue
        case $(head -c 4 "$one" 2>/dev/null) in
            YM5!|YM6!)
                printf '%s\n' "$one"
                return
                ;;
        esac
    done
    say "$packed holds no YM5! or YM6! dump that $unpacker could reach"
    exit 1
}

# The last name is what to write; every name before it is a tune.
tunes=$(($# - 1))
at=0
while [ "$at" -lt "$tunes" ]; do
    one=$1
    shift
    # dump runs in a command substitution, so what it exits with reaches
    # here and nothing else does. Its value is taken before it is used.
    got=$(dump "$one") || exit $?
    if [ -z "$got" ]; then
        exit 1
    fi
    set -- "$@" "$got"
    at=$((at + 1))
done
out=$1
shift

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# shellcheck disable=SC2086
"$root/bin/ym-to-ymxs" "$@" "$out" $flags

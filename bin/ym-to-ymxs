#!/bin/sh
# A YM5!/YM6! register dump into the text form, run out of target/classes;
# builds first where a source or the pom is newer than the last build.
# An example: doc/ym.md.
set -e
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
classes=$root/target/classes
built=$classes/.built
if [ ! -f "$built" ] || [ -n "$(find "$root/src/main/java" "$root/pom.xml" -newer "$built" -print -quit 2>/dev/null)" ]; then
    (cd "$root" && mvn -q compile >/dev/null)
    : > "$built"
fi
exec java -ea -cp "$classes" org.ymxs.ym.Main "$@"
